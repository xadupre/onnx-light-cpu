@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@ONNX_LIGHT_CPU_WITH_ONNX_LIGHT@)
  find_dependency(onnx_light CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/onnx_light_cpuTargets.cmake")

if(NOT TARGET onnx_light_cpu::lib_onnx_light_cpu)
  add_library(onnx_light_cpu::lib_onnx_light_cpu INTERFACE IMPORTED)
  set_target_properties(onnx_light_cpu::lib_onnx_light_cpu PROPERTIES
      INTERFACE_LINK_LIBRARIES onnx_light_cpu::cpu_compute)
endif()

check_required_components(onnx_light_cpu)
